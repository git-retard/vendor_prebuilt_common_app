android_app_import {
        name: "Obsidian",
        apk: "Obsidian/obsidian.apk",
        presigned: true,
        preprocessed: true,
        skip_preprocessed_apk_checks: true,
        product_specific: true,
        optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
        ],
}


